# Configuration file for build-nginx.sh
# Values set here override internal defaults. Commented lines show available options.

# -----------------------------------------------------------------------------
# 1. Release channel and version selection
# -----------------------------------------------------------------------------
NGINX_CHANNEL=stable
# NGINX_CHANNEL=mainline
# NGINX_CHANNEL=pinned

APP_VERSION=
# APP_VERSION=1.30.4

NGINX_REF=
# NGINX_REF=release-1.30.4

INTERACTIVE=0
# INTERACTIVE=1

# -----------------------------------------------------------------------------
# 2. OpenSSL library mode and version
# -----------------------------------------------------------------------------
# OPENSSL_MODE=bundled
OPENSSL_MODE=system

#OPENSSL_VERSION=3.5.7

#OPENSSL_REF=
# OPENSSL_REF=openssl-3.5.7

# -----------------------------------------------------------------------------
# 3. CPU tuning and hardening flags
# -----------------------------------------------------------------------------
CPU_OPT=native
# CPU_OPT=generic

AUTO_VAR_INIT=zero
# AUTO_VAR_INIT=pattern
# AUTO_VAR_INIT=uninitialized

# -----------------------------------------------------------------------------
# 4. Dependency versions and exact refs (for reproducible builds)
# -----------------------------------------------------------------------------
PCRE_VERSION=
PCRE_REF=
# PCRE_REF=pcre2-10.45

ZLIB_VERSION=
ZLIB_REF=
# ZLIB_REF=v2.2.4

ZSTD_VERSION=
ZSTD_REF=
# ZSTD_REF=v0.1.1

BROTLI_REF=
# BROTLI_REF=v1.1.0

HEADERS_MORE_REF=
# HEADERS_MORE_REF=v0.38

CACHE_PURGE_REF=
# CACHE_PURGE_REF=2.5.3

# -----------------------------------------------------------------------------
# 5. Build, installation, and log paths
# -----------------------------------------------------------------------------
BUILD_LOG=/tmp/nginx-build.log
# BUILD_LOG=/var/log/nginx-build.log

PREFIX=/usr/share
# PREFIX=/opt/nginx

SBIN_PATH=/usr/sbin/nginx
# SBIN_PATH=/opt/nginx/sbin/nginx

CONF_PATH=/etc/nginx/nginx.conf
# CONF_PATH=/opt/nginx/conf/nginx.conf

PID_PATH=/run/nginx.pid
# PID_PATH=/run/nginx-custom.pid

LOCK_PATH=/var/lock/nginx.lock
# LOCK_PATH=/run/lock/nginx-custom.lock

HTTP_LOG_PATH=/var/log/nginx/access.log
# HTTP_LOG_PATH=/var/log/nginx-custom/access.log

ERROR_LOG_PATH=/var/log/nginx/error.log
# ERROR_LOG_PATH=/var/log/nginx-custom/error.log

CLIENT_TEMP_PATH=/var/lib/nginx/body
# CLIENT_TEMP_PATH=/var/cache/nginx-custom/client_temp

PROXY_TEMP_PATH=/var/lib/nginx/proxy
# PROXY_TEMP_PATH=/var/cache/nginx-custom/proxy_temp

FASTCGI_TEMP_PATH=/var/lib/nginx/fastcgi
# FASTCGI_TEMP_PATH=/var/cache/nginx-custom/fastcgi_temp

MODULES_PATH=/usr/share/nginx/modules
# MODULES_PATH=/usr/local/nginx/modules

LOG_DIR=/var/log/nginx
# LOG_DIR=/var/log/nginx-custom

CACHE_DIR=/var/cache/nginx
# CACHE_DIR=/var/cache/nginx-custom

# -----------------------------------------------------------------------------
# 6. Runtime user and compiler toolchain
# -----------------------------------------------------------------------------
RUNTIME_USER=www-data
# RUNTIME_USER=nginx

RUNTIME_GROUP=www-data
# RUNTIME_GROUP=nginx

# LLVM / Clang toolchain (default)
CC=clang
CXX=clang++
LD=lld
AR=llvm-ar
NM=llvm-nm
RANLIB=llvm-ranlib
STRIP=llvm-strip

# GCC toolchain alternative (uncomment as a group when using GCC)
# CC=gcc
# CXX=g++
# LD=ld.lld
# AR=gcc-ar
# NM=gcc-nm
# RANLIB=gcc-ranlib
# STRIP=strip

# -----------------------------------------------------------------------------
# 7. Build controls and features
# -----------------------------------------------------------------------------
JOBS=10
# JOBS=8

BUILD_DIR=
# BUILD_DIR=/var/tmp/nginx-build

KEEP_BUILD=0
# KEEP_BUILD=1

SKIP_DEPS=0
# SKIP_DEPS=1

INSTALL_CONFIG=1
# INSTALL_CONFIG=0

ENABLE_UPX=0
# ENABLE_UPX=auto
# ENABLE_UPX=1

NGINX_DEBUG=0
# NGINX_DEBUG=1
